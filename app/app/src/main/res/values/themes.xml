<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Window theme and styling for the remaining View-based UI. Compose UI is themed in ui/theme/Theme.kt. -->
    <style name="Base.Theme.LibreInfo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gray_13</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Night-specific overrides go in values-night/themes.xml -->
    <style name="Theme.LibreInfo" parent="Base.Theme.LibreInfo" />

    <style name="AlertDialogStyle" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
<!--        <item name="android:background">@drawable/round_background</item>-->
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:radius">30dp</item>
    </style>
</resources>
