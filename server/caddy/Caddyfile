{
    order rate_limit first
}

localhost {
    @api not path /stream /stream/* /static/*
    rate_limit @api {
        zone api_burst {
            key {remote_host}
            events 40
            window 1m
        }
        zone api_hourly {
            key {remote_host}
            events 500
            window 1h
        }
    }

    @bad_token not header X-App-Token "1234"
    handle @bad_token {
        respond 403
    }

    handle /departures {
            rate_limit {
                zone departures {
                    key {remote_host}
                    events 1
                    window 5s
            }
        }
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy api:8080
    }
}
